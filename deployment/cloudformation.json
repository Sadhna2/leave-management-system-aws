  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "LMS Member 3: private RDS MySQL, Java Lambda API, transactional SNS/SQS delivery and private S3 archive",
  "Metadata": {
    "ProjectDocumentation": "deployment/README.md",
    "BuildSHA256": "828346eb2db07607c19b7fceb5c13f367ef30809bcddd1cf60fcf51e692ba3c4",
    "NetworkDesign": "Dedicated VPC; private RDS; no NAT or Internet Gateway; SNS interface and S3 gateway endpoints",
    "DataRetention": "RDS snapshots, secrets and the externally created versioned private S3 bucket survive stack removal",
    "Recovery": "Reuses three retained secrets; VPC quota freed by confirmed deletion of unused vpc-045d07c90f37c0db7",
    "FrontendDesign": "Compiled frontend files only; public GetObject over HTTPS; no list/write access; HashRouter at /index.html",
    "ArchiveBuildSHA256": "3d4a404dbbf3b1ecc035bd9227e323a4f1b448ecd001f5759984c5a23b567a47",
    "ArchiveRuntime": "Java 17; replaces the original inline Python worker"
  },
